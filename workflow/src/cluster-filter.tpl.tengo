// Stage 3 — paper's "binder" cluster filter (optional, R58 / R60).
//
// Pure template — wf.render arguments = (inputTsv, clusterMin, chain).
// `args.applyClusterFilter` is the WORKFLOW-level conditional that
// gates whether this template runs at all; it is NOT an input here.
// Cache key = (inputTsv, clusterMin), independent of threshold —
// Stages 1 + 2 stay cached on threshold changes (R56).

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")

self.defineOutputs("outputTsv", "statsJson")

clusterFilterSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:cluster-filter")

self.body(func(inputs) {
	inputTsv := inputs.inputTsv
	clusterMin := inputs.clusterMin
	chain := inputs.chain

	cmd := exec.builder().
		software(clusterFilterSw).
		cpu(1).
		mem("4GiB").
		arg("--input").arg("input.tsv").
		arg("--output").arg("output.tsv").
		arg("--stats-json").arg("stats.json").
		arg("--cluster-min").arg(string(clusterMin)).
		arg("--chain").arg(chain).
		addFile("input.tsv", inputTsv).
		saveFile("output.tsv").
		saveFileContent("stats.json").
		run()

	return {
		outputTsv: cmd.getFile("output.tsv"),
		statsJson: cmd.getFileContent("stats.json")
	}
})
