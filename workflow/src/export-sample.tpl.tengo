// Single-sample export collapse.
//
// Pure template: cache key = (inputTsv, sampleId). Filtering the full
// multi-sample TSV down to one sample is the expensive part (it reads
// every sample's rows), so isolating it in a PURE template is what lets
// the filtered result dedup across blocks and runs — the chosen sample's
// rows are identical regardless of which block instance asks for them.
// The block-specific import (blockId-tagged columns) stays in the caller
// and reads this small filtered TSV, so it never re-reads the full TSV.
//
// The pure-template boundary is what content-addresses the output; inline
// `pt` in the caller would not dedup across blocks, so a second
// same-settings block would re-run the multi-minute filter.

self := import("@platforma-sdk/workflow-tengo:tpl")
pt := import("@platforma-sdk/workflow-tengo:pt")

self.defineOutputs("outputTsv")

self.body(func(inputs) {
	ptWf := pt.workflow().mem("4GiB").cpu(2)
	// inferSchema:false so sampleId reads as String — otherwise numeric-looking
	// ids infer as Int64 and the eq() vs the String exportSampleId silently
	// matches zero rows (empty export).
	ptWf.frame(inputs.inputTsv, { xsvType: "tsv", inferSchema: false }).
		filter(pt.col("sampleId").eq(pt.lit(inputs.sampleId))).
		save("export.tsv")

	return {
		outputTsv: ptWf.run().getFile("export.tsv")
	}
})
