// Per-sample neighbour computation.
//
// processColumn body: receives ONE sample's slice of the packed convergence
// input — a String PColumn keyed by clonotypeKey whose value is
// "aaSeqCDR3|nSeqCDR3" (packed in main so both CDR3 columns ride through the
// single sliced primary).
// The sampleId is the processColumn group key and is NOT present in this
// slice's content, so the body node's input — and therefore its cache id —
// depends only on the sample's clonotype data. That is what makes a project
// analysing a SUBSET of samples recover each shared sample from cache.
//
// Body: unpack the String column back into columns, write a per-sample TSV,
// run compute-neighbours once (it's already one sample).
self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pt := import("@platforma-sdk/workflow-tengo:pt")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")

// outputTsv — the convergence columns for this sample (collected as an Xsv
//             output and reassembled into the block's tables/histograms).
// log       — this sample's compute-neighbours stdout (collected as a
//             per-sample Log Resource; the model attaches the real sample
//             label and the UI renders one PlLogView per sample).
// status    — { nUniqueNt, nMin } for this sample (a Json Resource keyed by
//             sampleId). Exists even when the sample is skipped (empty TSV),
//             so the model can build the skipped-samples warning.
self.defineOutputs("outputTsv", "log", "status")

computeNeighboursSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:compute-neighbours")
clusterFilterSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:cluster-filter")
fullStarSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:full-star")

self.body(func(inputs) {
	// The sample's slice: String column keyed by clonotypeKey. The runner
	// builds/locks the group resource before rendering, so no awaitState here.
	packedData := inputs[pConstants.VALUE_FIELD_NAME]
	clonoAxisSpec := inputs.clonoAxisSpec

	// Spec for exporting the slice back to a TSV (one axis + the packed value).
	// xsv.exportFrame writes each column's pl7.app/label as the TSV header (NOT
	// the spec name). Use clean, predictable labels so the pt decode below can
	// reference fixed headers regardless of the upstream clonotype axis label.
	// Identity (name/type/domain) is preserved, so the spec still matches the data.
	exportClonoAxisSpec := {
		name: clonoAxisSpec.name,
		type: clonoAxisSpec.type,
		domain: clonoAxisSpec.domain,
		annotations: { "pl7.app/label": "clonotypeKey" }
	}
	packedColSpec := {
		kind: "PColumn",
		name: "packed",
		valueType: "String",
		annotations: { "pl7.app/label": "packed" },
		axesSpec: [exportClonoAxisSpec]
	}
	packedTsv := xsv.exportFrame([{ spec: packedColSpec, data: packedData }], "tsv", {})

	// Unpack "aaSeqCDR3|nSeqCDR3(|Pgen)" -> columns; emit the TSV
	// compute-neighbours expects (clonotypeKey, aaSeqCDR3, nSeqCDR3), plus Pgen
	// in the full-STAR path (it passes through compute-neighbours unused, so the
	// full-STAR stage reads it from neighbours.tsv without a separate join, and
	// compute-neighbours' pinned cache is unaffected). CDR3 sequences never
	// contain "|", so it's an unambiguous delimiter; `hasPgen` picks the 2- vs
	// 3-field pattern (matches the packing in :pack-input).
	hasPgen := inputs.hasPgen
	packedPattern := hasPgen ? "([^|]*)\\|([^|]*)\\|([^|]*)" : "([^|]*)\\|([^|]*)"
	ptwf := pt.workflow().mem("4GiB").cpu(2)
	df := ptwf.frame(packedTsv, { xsvType: "tsv", inferSchema: false })
	unpackCols := [
		pt.col("packed").strExtract(packedPattern, { groupIndex: 1 }).alias("aaSeqCDR3"),
		pt.col("packed").strExtract(packedPattern, { groupIndex: 2 }).alias("nSeqCDR3")
	]
	selectCols := [pt.col("clonotypeKey"), pt.col("aaSeqCDR3"), pt.col("nSeqCDR3")]
	if hasPgen {
		unpackCols = append(unpackCols, pt.col("packed").strExtract(packedPattern, { groupIndex: 3 }).alias("Pgen"))
		selectCols = append(selectCols, pt.col("Pgen"))
	}
	df = df.withColumns(unpackCols...).select(selectCols...)
	df.save("input.tsv")
	ptRes := ptwf.run()
	perSampleInputTsv := ptRes.getFile("input.tsv")

	// Stage 1 — neighbour density (the expensive STAR run). Pinned with
	// cacheHours so a threshold-only change recovers it instead of recomputing
	// (its CID excludes threshold). stdout is captured as CONTENT (not a live
	// stream) so it survives cache and resolves atomically — the model shows a
	// "Starting…" placeholder until the whole log is ready, then the text in one
	// step (a live stream blinks empty between handle-resolve and first line).
	// status.json carries the unique-nt-CDR3 count + nMin for the
	// skipped-samples warning.
	neighboursCmd := exec.builder().
		software(computeNeighboursSw).
		cpu(2).
		mem("4GiB").
		arg("--input").arg("input.tsv").
		arg("--output").arg("neighbours.tsv").
		arg("--nMin").arg(string(inputs.nMin)).
		arg("--chain").arg(inputs.chain).
		arg("--status-json").arg("status.json").
		addFile("input.tsv", perSampleInputTsv).
		saveFile("neighbours.tsv").
		saveFileContent("status.json").
		saveStdoutContent().
		cacheHours(24).
		run()

	// Stage 2 — hit calling, PARALLEL modes (A-0003/A-0010 v2). fast-STAR runs on
	// EVERY chain (the always-on baseline); full-STAR is ADDED when this chain's
	// Pgen is present. Both emit side by side with distinct v1-style names
	// (A-0012): fast-STAR → nbFreq (= Nb_freq) + fastStar (threshold hit);
	// full-STAR → fullStarScore (= -log10 p) + fullStar (BH hit).
	//
	// When Pgen is present, run full-STAR first: full_star.py emits fullstar.tsv
	// = neighbours.tsv + Pvalue + starHit over ALL rows, so it's a superset we can
	// base the merged pt step on. Otherwise base on neighbours.tsv (fast only).
	baseTsv := neighboursCmd.getFile("neighbours.tsv")
	if hasPgen {
		// full-STAR: Poisson tail vs the Pgen null + Benjamini-Hochberg at alpha.
		// uniq_nucl is derived from neighbours.tsv's nSeqCDR3 (== the nUniqueNt
		// compute-neighbours reports), so compute-neighbours stays byte-identical
		// (its pinned cache survives alpha tweaks). full_star.py emits raw Pvalue
		// + its BH hit ("starHit"); the pt step below turns those into
		// fullStarScore = -log10(Pvalue) + fullStar.
		fullStarCmd := exec.builder().
			software(fullStarSw).
			cpu(1).
			mem("2GiB").
			arg("--input").arg("neighbours.tsv").
			arg("--output").arg("fullstar.tsv").
			arg("--alpha").arg(string(inputs.alpha)).
			arg("--chain").arg(inputs.chain).
			arg("--neighbours-column").arg("neighbours").
			arg("--pgen-column").arg("Pgen").
			addFile("neighbours.tsv", neighboursCmd.getFile("neighbours.tsv")).
			saveFile("fullstar.tsv").
			run()
		baseTsv = fullStarCmd.getFile("fullstar.tsv")
	}

	// Derive the per-mode columns. inferSchema false → cast Nb_freq / Pvalue to
	// Float64 only where compared, so blank / non-numeric values become null →
	// "Not hit" / null score. fast-STAR always; full-STAR columns appended when
	// Pgen was present (Pvalue / starHit exist in the superset base).
	callWf := pt.workflow().mem("1GiB").cpu(1)
	callCols := [
		pt.col("Nb_freq").cast("Float64").alias("nbFreq"),
		pt.when(pt.col("Nb_freq").cast("Float64").gt(pt.lit(inputs.threshold))).
			then(pt.lit("Hit")).
			otherwise(pt.lit("Not hit")).
			alias("fastStar")
	]
	if hasPgen {
		callCols = append(callCols,
			pt.col("Pvalue").cast("Float64").log10().negate().alias("fullStarScore"),
			pt.col("starHit").alias("fullStar"))
	}
	callDf := callWf.frame(baseTsv, { xsvType: "tsv", inferSchema: false }).withColumns(callCols...)
	callDf.save("called.tsv")
	calledTsv := callWf.run().getFile("called.tsv")

	// Stage 3 — paper's cluster filter, only when enabled. Refines the fast-STAR
	// hit (fastStar) → fastStarClusterFiltered + clusterSize (A-0012). One sample
	// per invocation, so clustering is within this sample's rows.
	finalTsv := calledTsv
	if inputs.applyClusterFilter {
		clusterCmd := exec.builder().
			software(clusterFilterSw).
			cpu(1).
			mem("4GiB").
			arg("--input").arg("called.tsv").
			arg("--output").arg("output.tsv").
			arg("--cluster-min").arg(string(inputs.clusterMin)).
			arg("--chain").arg(inputs.chain).
			arg("--hit-column").arg("fastStar").
			addFile("called.tsv", finalTsv).
			saveFile("output.tsv").
			run()
		finalTsv = clusterCmd.getFile("output.tsv")
	}

	return {
		outputTsv: finalTsv,
		log: neighboursCmd.getStdoutContent(),
		status: neighboursCmd.getFileContent("status.json")
	}
})
