// De-anonymize the skipped-samples report (MILAB-6413). Stage 1 emits
// `skipped.json` ({ belowMin: [<display>], allEmpty, nMin }) in fingerprint
// space because the heavy TSV carries anonymized sampleIds and no sampleLabel.
// Restore each belowMin entry: fingerprint -> real sampleId (via `mapping`)
// -> human label (via `labelLookup`, falling back to the real sampleId).
// Rendered ephemerally (per-project) — the mapping is project-specific.
self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")

self.defineOutputs("skippedJson")

self.awaitState("anonymizedSkipped", "ResourceReady")
self.awaitState("mapping", "ResourceReady")

self.body(func(args) {
	// `mapping` / `anonymizedSkipped` may arrive as a resource or as an
	// already-decoded map depending on how the input resolved — handle both.
	readJson := func(v) {
		if smart.isResource(v) {
			return v.getDataAsJson()
		} else if is_map(v) {
			return v
		}
		return smart.resource(v).getDataAsJson()
	}

	skipped := readJson(args.anonymizedSkipped)
	mappingJson := readJson(args.mapping) // { fingerprint -> real sampleId }

	// Plain map passed by value from the parent (real sampleId -> human label);
	// {} when the block has no sample-label column.
	labelLookup := args.labelLookup
	if is_undefined(labelLookup) {
		labelLookup = {}
	}

	newBelowMin := []
	if !is_undefined(skipped.belowMin) {
		for fp in skipped.belowMin {
			display := fp
			realId := mappingJson[fp]
			if !is_undefined(realId) {
				display = realId
				lbl := labelLookup[realId]
				if !is_undefined(lbl) {
					display = lbl
				}
			}
			newBelowMin = append(newBelowMin, display)
		}
	}
	skipped.belowMin = newBelowMin

	return {
		skippedJson: smart.createJsonResource(skipped)
	}
})
