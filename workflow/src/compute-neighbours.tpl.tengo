// Stage 1 — multiplicity-weighted Hamming-1 neighbour density.
//
// Pure template per R56: cache key = (inputTsv, nMin, chain) — threshold
// is intentionally NOT in this template's arguments so cache survives
// threshold tweaks. Threshold lives in Stage 2 (apply-threshold.tpl.tengo).

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")

self.defineOutputs("outputTsv", "logs", "skippedJson")

computeNeighboursSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:compute-neighbours")

self.body(func(inputs) {
	inputTsv := inputs.inputTsv
	nMin := inputs.nMin
	chain := inputs.chain

	// Resource budget per R43.
	cmd := exec.builder().
		software(computeNeighboursSw).
		cpu(2).
		mem("4GiB").
		arg("--input").arg("input.tsv").
		arg("--output").arg("output.tsv").
		arg("--nMin").arg(string(nMin)).
		arg("--chain").arg(chain).
		arg("--skipped-json").arg("skipped.json").
		addFile("input.tsv", inputTsv).
		saveFile("output.tsv").
		saveFileContent("skipped.json").
		saveStdoutStream().
		// Pin the expensive neighbour computation in cache so threshold-only
		// changes (which re-render the workflow but leave this pure stage's
		// inputs identical) recover this result instead of recomputing it.
		// Without a TTL the intermediate output is unreferenced once Stage 2
		// consumes it and reference-counting GC drops it before the next
		// render can reuse it. Matches the heavy MiXCR stages
		// (mixcr-analyze: cache 48h). R56.
		cacheHours(24).
		run()

	return {
		outputTsv: cmd.getFile("output.tsv"),
		logs: cmd.getStdoutStream(),
		skippedJson: cmd.getFileContent("skipped.json")
	}
})
