// Stage 2 — apply threshold to Nb_freq, emit fastStar column.
//
// Pure template per R56: cache key = (inputTsv, threshold, chain).
// Threshold changes invalidate only this stage; Stage 1's expensive
// neighbour-count output is recovered from cache.

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
exec := import("@platforma-sdk/workflow-tengo:exec")

self.defineOutputs("outputTsv", "logs")

applyThresholdSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:apply-threshold")

self.body(func(inputs) {
	inputTsv := inputs.inputTsv
	threshold := inputs.threshold
	chain := inputs.chain

	cmd := exec.builder().
		software(applyThresholdSw).
		cpu(1).
		mem("1GiB").
		arg("--input").arg("input.tsv").
		arg("--output").arg("output.tsv").
		arg("--threshold").arg(string(threshold)).
		arg("--chain").arg(chain).
		addFile("input.tsv", inputTsv).
		saveFile("output.tsv").
		saveStdoutStream().
		run()

	return {
		outputTsv: cmd.getFile("output.tsv"),
		logs: cmd.getStdoutStream()
	}
})
