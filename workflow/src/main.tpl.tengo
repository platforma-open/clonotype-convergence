// Clonotype convergence — main workflow template.
//
// Resolves three sibling PColumns on the (sampleId, clonotypeKey) axes
// of args.inputRef — aa CDR3, nt CDR3, abundance — for the chain named
// by args.chain. Combines them into one multi-sample TSV via
// pframes.tsvFileBuilder, then runs two pure templates: Stage 1
// (compute-neighbours, threshold-INDEPENDENT, R56) and Stage 2
// (apply-threshold, threshold-DEPENDENT). Imports Stage 2's TSV back
// into three PColumns with chain-tagged column domains (R30) and
// pSpec.makeTrace provenance (R29).
//
// Phase 3 → 4: chain comes from args.chain (set by the model). Sibling
// queries are chain-scoped via the domain selector so a multi-chain
// dataset (IGH + IGK) doesn't return both chains' columns.
//
// Per-sample fan-out via pframes.processColumn (R34) is still deferred;
// Python groups by sampleId column on the multi-sample TSV. See the
// commit body of 59657d6 for the trade-off note.

wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
maps := import("@platforma-sdk/workflow-tengo:maps")
json := import("json")

computeNeighboursTpl := assets.importTemplate(":compute-neighbours")
applyThresholdTpl := assets.importTemplate(":apply-threshold")

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	// ignoreMissingDomains makes the chain domain selector lenient when
	// MiXCR puts chain on the clonotype-key axis instead of the column
	// domain itself.
	bb.ignoreMissingDomains()
	bb.addAnchor("main", args.inputRef)

	// MiXCR partitions per-clonotype data (CDR3, V/J, etc.) on a
	// single-axis frame [clonotypeKey] and per-(sample, clonotype) data
	// (abundance) on a two-axis frame. tsvFileBuilder joins across
	// frames on the shared clonotypeKey axis automatically.

	// aa CDR3 — per-clonotype, single-axis sibling.
	// Chain isn't in the column domain on MiXCR's CDR3 sequence columns —
	// it lives on the clonotype-key axis domain. The anchored axes:1
	// match already restricts us to the anchor's chain, so we don't
	// constrain chain in the column domain selector here.
	bb.addSingle({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/vdj/feature": "CDR3",
			"pl7.app/alphabet": "aminoacid"
		}
	}, "aaCDR3")

	bb.addSingle({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/vdj/feature": "CDR3",
			"pl7.app/alphabet": "nucleotide"
		}
	}, "ntCDR3")

	// Primary abundance for the chain — per-(sample, clonotype), two-axis sibling.
	bb.addSingle({
		axes: [{ anchor: "main", idx: 0 }, { anchor: "main", idx: 1 }],
		domain: {
			"pl7.app/vdj/chain": args.chain
		},
		annotations: {
			"pl7.app/isAbundance": "true",
			"pl7.app/abundance/isPrimary": "true"
		}
	}, "abundance")

	return { columns: bb.build() }
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()
	columns := args.columns
	chain := args.chain

	// Anchor IS the primary abundance column (see prepare comment).
	// columns.getColumn returns a {spec, data} object that tsvFileBuilder
	// accepts directly (cf. clonotype-clustering's seqTableBuilder usage).
	anchorSpec := columns.getSpec(args.inputRef)

	tsvBuilder := pframes.tsvFileBuilder()
	tsvBuilder.cpu(2)
	tsvBuilder.mem("4GiB")
	tsvBuilder.setAxisHeader(anchorSpec.axesSpec[0].name, "sampleId")
	tsvBuilder.setAxisHeader(anchorSpec.axesSpec[1].name, "clonotypeKey")
	tsvBuilder.add(columns.getColumn("aaCDR3"), { header: "aaSeqCDR3" })
	tsvBuilder.add(columns.getColumn("ntCDR3"), { header: "nSeqCDR3" })
	tsvBuilder.add(columns.getColumn(args.inputRef), { header: "abundance" })
	inputTsv := tsvBuilder.build()

	// Stage 1 — threshold-INDEPENDENT, expensive (R56).
	stage1 := render.create(computeNeighboursTpl, {
		inputTsv: inputTsv,
		nMin: args.nMin,
		chain: chain
	})

	// Stage 2 — threshold-dependent, cheap (R56).
	stage2 := render.create(applyThresholdTpl, {
		inputTsv: stage1.output("outputTsv"),
		threshold: args.threshold,
		chain: chain
	})

	// Import the Stage 2 TSV back into PColumns on the input axes (R31).
	// Column domain double-tags block-instance + chain per R30.
	importSpec := {
		axes: [
			{ column: "sampleId", spec: anchorSpec.axesSpec[0] },
			{ column: "clonotypeKey", spec: anchorSpec.axesSpec[1] }
		],
		columns: [
			{
				column: "neighbours",
				spec: {
					name: "pl7.app/vdj/convergence/neighbours",
					valueType: "Int",
					domain: {
						"pl7.app/block": blockId,
						"pl7.app/vdj/chain": chain
					},
					annotations: {
						"pl7.app/label": "Convergent neighbours (Hamming-1)",
						"pl7.app/table/visibility": "optional"
					}
				}
			},
			{
				column: "Nb_freq",
				spec: {
					name: "pl7.app/vdj/convergence/nbFreq",
					valueType: "Double",
					domain: {
						"pl7.app/block": blockId,
						"pl7.app/vdj/chain": chain
					},
					annotations: {
						"pl7.app/label": "Convergent neighbour frequency",
						"pl7.app/table/visibility": "optional",
						// R48 — last-run threshold dashed line on the histogram.
						"pl7.app/graph/thresholds": string(json.encode([{ value: args.threshold, label: "Threshold" }]))
					}
				}
			},
			{
				column: "fastStar",
				spec: {
					name: "pl7.app/vdj/convergence/fastStar",
					valueType: "Int",
					domain: {
						"pl7.app/block": blockId,
						"pl7.app/vdj/chain": chain
					},
					annotations: {
						"pl7.app/label": "Convergent hit (fast-STAR)",
						"pl7.app/table/visibility": "default"
					}
				}
			}
		],
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}

	importedFrames := xsv.importFile(stage2.output("outputTsv"), "tsv", importSpec, {
		splitDataAndSpec: true,
		mem: "4GiB",
		cpu: 2
	})

	// Trace + chain identity flow through pSpec.makeTrace + trace.inject (R29).
	trace := pSpec.makeTrace(anchorSpec, {
		type: "milaboratories.clonotype-convergence",
		id: blockId,
		importance: 50,
		label: "Clonotype convergence (fast-STAR)"
	})

	pfBuilder := pframes.pFrameBuilder()
	for k in maps.getKeys(importedFrames) {
		v := importedFrames[k]
		pfBuilder.add(k, trace.inject(v.spec), v.data)
	}
	outputPf := pfBuilder.build()

	return {
		outputs: {
			convergencePf: pframes.exportFrame(outputPf),
			stage1Logs: stage1.output("logs"),
			stage2Logs: stage2.output("logs")
		},
		exports: {
			convergence: outputPf
		}
	}
})
