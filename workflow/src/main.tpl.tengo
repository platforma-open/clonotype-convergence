// Clonotype convergence — main workflow template.
//
// Always processes the heavy chain (args.inputRef). When the user picks
// a light chain via the model's snapshot (args.lightChainRef +
// args.lightChainName), a parallel LC pipeline runs against that anchor
// and emits a second set of convergence PColumns chain-tagged with the
// LC chain domain value. Both pipelines reuse the same two pure
// templates (compute-neighbours + apply-threshold) — Stage 1's
// content-addressed cache means each chain's expensive work is
// recovered on its own.

wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
maps := import("@platforma-sdk/workflow-tengo:maps")
json := import("json")

computeNeighboursTpl := assets.importTemplate(":compute-neighbours")
applyThresholdTpl := assets.importTemplate(":apply-threshold")

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	// ignoreMissingDomains tolerates MiXCR placing chain on the
	// clonotype-key axis domain instead of the column domain.
	bb.ignoreMissingDomains()

	// Heavy chain anchor + siblings.
	bb.addAnchor("main", args.inputRef)
	bb.addSingle({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/vdj/feature": "CDR3",
			"pl7.app/alphabet": "aminoacid"
		}
	}, "aaCDR3")
	bb.addSingle({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/vdj/feature": "CDR3",
			"pl7.app/alphabet": "nucleotide"
		}
	}, "ntCDR3")
	// Sample label — single-axis sibling on sampleId only. Shared
	// between heavy and light pipelines (same samples).
	bb.addMulti({
		axes: [{ anchor: "main", idx: 0 }],
		name: "pl7.app/label"
	}, "sampleLabel")

	// Light chain anchor + siblings — conditional on the user picking
	// an LC option in the settings. The LC anchor lives on different
	// axes (different clonotypeKey-IGLight axis) so it's a separate
	// bundle anchor.
	if !is_undefined(args.lightChainRef) {
		bb.addAnchor("light", args.lightChainRef)
		bb.addSingle({
			axes: [{ anchor: "light", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: {
				"pl7.app/vdj/feature": "CDR3",
				"pl7.app/alphabet": "aminoacid"
			}
		}, "lightAaCDR3")
		bb.addSingle({
			axes: [{ anchor: "light", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: {
				"pl7.app/vdj/feature": "CDR3",
				"pl7.app/alphabet": "nucleotide"
			}
		}, "lightNtCDR3")
	}

	return { columns: bb.build() }
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()
	columns := args.columns

	// Sample-label column is optional (older datasets may not have one).
	// Bind once and reuse across both pipelines.
	labelCols := columns.getColumns("sampleLabel")
	hasSampleLabel := len(labelCols) > 0

	// runChainPipeline — closure that builds a TSV from (aa, nt, abundance,
	// optional sampleLabel), runs Stage 1 then Stage 2, and imports the
	// final TSV back into a pframe of three convergence PColumns
	// (neighbours, Nb_freq, fastStar) chain-tagged with `chainName`.
	// Returns the built pframe.
	runChainPipeline := func(anchorRef, aaKey, ntKey, chainName, threshold) {
		anchorSpec := columns.getSpec(anchorRef)

		tsvBuilder := pframes.tsvFileBuilder()
		tsvBuilder.cpu(2)
		tsvBuilder.mem("4GiB")
		tsvBuilder.setAxisHeader(anchorSpec.axesSpec[0].name, "sampleId")
		tsvBuilder.setAxisHeader(anchorSpec.axesSpec[1].name, "clonotypeKey")
		tsvBuilder.add(columns.getColumn(aaKey), { header: "aaSeqCDR3" })
		tsvBuilder.add(columns.getColumn(ntKey), { header: "nSeqCDR3" })
		tsvBuilder.add(columns.getColumn(anchorRef), { header: "abundance" })
		if hasSampleLabel {
			tsvBuilder.add(labelCols[0], { header: "sampleLabel" })
		}
		inputTsv := tsvBuilder.build()

		stage1 := render.create(computeNeighboursTpl, {
			inputTsv: inputTsv,
			nMin: args.nMin,
			chain: chainName
		})

		stage2 := render.create(applyThresholdTpl, {
			inputTsv: stage1.output("outputTsv"),
			threshold: threshold,
			chain: chainName
		})

		importSpec := {
			axes: [
				{ column: "sampleId", spec: anchorSpec.axesSpec[0] },
				{ column: "clonotypeKey", spec: anchorSpec.axesSpec[1] }
			],
			columns: [
				{
					column: "neighbours",
					spec: {
						name: "pl7.app/vdj/convergence/neighbours",
						valueType: "Int",
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/vdj/chain": chainName
						},
						annotations: {
							"pl7.app/label": "Convergent neighbours (Hamming-1)",
							"pl7.app/table/visibility": "optional"
						}
					}
				},
				{
					column: "Nb_freq",
					spec: {
						name: "pl7.app/vdj/convergence/nbFreq",
						valueType: "Double",
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/vdj/chain": chainName
						},
						annotations: {
							"pl7.app/label": "Convergent neighbour frequency",
							"pl7.app/table/visibility": "optional",
							"pl7.app/graph/thresholds": string(json.encode([{ value: threshold, label: "Threshold" }]))
						}
					}
				},
				{
					column: "fastStar",
					spec: {
						name: "pl7.app/vdj/convergence/fastStar",
						valueType: "Int",
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/vdj/chain": chainName
						},
						annotations: {
							"pl7.app/label": "Convergent hit (fast-STAR)",
							"pl7.app/table/visibility": "default"
						}
					}
				}
			],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}

		importedFrames := xsv.importFile(stage2.output("outputTsv"), "tsv", importSpec, {
			splitDataAndSpec: true,
			mem: "4GiB",
			cpu: 2
		})

		trace := pSpec.makeTrace(anchorSpec, {
			type: "milaboratories.clonotype-convergence",
			id: blockId,
			importance: 50,
			label: "Clonotype convergence (fast-STAR)"
		})

		pfBuilder := pframes.pFrameBuilder()
		for k in maps.getKeys(importedFrames) {
			v := importedFrames[k]
			pfBuilder.add(k, trace.inject(v.spec), v.data)
		}
		return {
			pf: pfBuilder.build(),
			stage1Logs: stage1.output("logs"),
			statsJson: stage2.output("statsJson")
		}
	}

	// Heavy pipeline — always runs.
	heavy := runChainPipeline(args.inputRef, "aaCDR3", "ntCDR3", args.chain, args.threshold)

	outputs := {
		convergencePf: pframes.exportFrame(heavy.pf),
		stage1Logs: heavy.stage1Logs,
		heavyHitStats: heavy.statsJson
	}
	exports := {
		convergence: heavy.pf
	}

	// Light pipeline — runs only when the user picked an LC chain.
	if !is_undefined(args.lightChainRef) {
		light := runChainPipeline(
			args.lightChainRef,
			"lightAaCDR3",
			"lightNtCDR3",
			args.lightChainName,
			args.thresholdL
		)
		outputs.lightConvergencePf = pframes.exportFrame(light.pf)
		outputs.lightStage1Logs = light.stage1Logs
		outputs.lightHitStats = light.statsJson
		exports.lightConvergence = light.pf
	}

	return {
		outputs: outputs,
		exports: exports
	}
})
