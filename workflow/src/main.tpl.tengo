// Clonotype convergence — main workflow template.
//
// Processes whichever chain(s) the user populated via the model's pickers:
//   - args.chainH set → run heavy pipeline, emit IGHeavy PColumns
//   - args.chainL set → run light pipeline, emit light PColumns
//                       (chain domain from args.chainLName)
// At least one must be populated (gated by the args lambda).
//
// Per-chain pipeline — fully per-sample. One `pframes.processColumn` fan-out
// per chain runs all stages inside the per-sample body
// (:per-sample-neighbours), so each sample is content-addressed and a
// subset project recovers shared samples from cache:
//   Stage 1 — expensive STAR neighbour-density run; cache survives
//             hit-call tweaks (cacheHours, CID excludes threshold/alpha/Pgen).
//   Stage 2 — hit calling. full-STAR (FDR-controlled Poisson test vs the Pgen
//             null, Benjamini-Hochberg at alpha) is PRIMARY when a Pgen column
//             resolved for the chain; fast-STAR (threshold) is the FALLBACK
//             when Pgen is absent (A-0010). Both emit unified starHit +
//             starScore; the `method` domain records which ran (A-0012).
//   Stage 3 — paper's binder cluster filter, only when
//             args.applyClusterFilter; method-agnostic (refines whichever
//             starHit set exists); emits starHitClusterFiltered + clusterSize;
//             starHit is NOT modified.
// The per-sample outputs (convergence columns + per-sample log + per-sample
// status) are reassembled here, keyed by the sampleId.
//
// Output channels:
//   outputs.* — the multi-sample (sampleId, clonotypeKey) p-frames that
//               feed this block's own table + histograms; never pooled.
//   exports.* — the clonotype-only aggregated convergence family for the
//               in-vivo score / lead selection (A-0006). NOT YET EMITTED —
//               the aggregation function is an open question (Q-0002); v1's
//               single-sample export is removed.

wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
exec := import("@platforma-sdk/workflow-tengo:exec")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
pt := import("@platforma-sdk/workflow-tengo:pt")
json := import("json")
times := import("times")

packInputTpl := assets.importTemplate(":pack-input")
perSampleNeighboursTpl := assets.importTemplate(":per-sample-neighbours")
aggregateSw := assets.importSoftware("@platforma-open/milaboratories.clonotype-convergence.software:aggregate")

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	// ignoreMissingDomains tolerates MiXCR placing chain on the
	// clonotype-key axis domain instead of the column domain.
	bb.ignoreMissingDomains()

	// cdr3DomainFor — sibling selector for the CDR3 sequence columns.
	// Bulk: domain is just (feature, alphabet); the anchor's axis-domain
	// chain disambiguates implicitly.
	// SC: domain ALSO carries scClonotypeChain (letter "A"/"B") so the
	// heavy and light siblings — which share the SC axis — don't
	// conflate when both populate the same args bundle.
	cdr3DomainFor := func(alphabet, scLetter) {
		d := {
			"pl7.app/vdj/feature": "CDR3",
			"pl7.app/alphabet": alphabet
		}
		if !is_undefined(scLetter) {
			d["pl7.app/vdj/scClonotypeChain"] = scLetter
			d["pl7.app/vdj/scClonotypeChain/index"] = "primary"
		}
		return d
	}

	// Anchor + CDR3 siblings per populated chain. In SC paired mode
	// chainH and chainL hold the SAME ref but the scClonotypeChain
	// letter on the domain filter keeps each chain's siblings distinct.
	if !is_undefined(args.chainH) {
		bb.addAnchor("heavy", args.chainH)
		bb.addSingle({
			axes: [{ anchor: "heavy", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: cdr3DomainFor("aminoacid", args.chainHScLetter)
		}, "heavyAaCDR3")
		bb.addSingle({
			axes: [{ anchor: "heavy", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: cdr3DomainFor("nucleotide", args.chainHScLetter)
		}, "heavyNtCDR3")
		bb.addMulti({
			axes: [{ anchor: "heavy", idx: 0 }],
			name: "pl7.app/label"
		}, "heavySampleLabel")
		// Clone-ID label (per-clonotype-axis pl7.app/label). Bundled
		// here so the histogram pframe ships labels alongside our
		// convergence columns — the model output passes the pframe
		// through, no anchored discovery at render time.
		bb.addMulti({
			axes: [{ anchor: "heavy", idx: 1 }],
			name: "pl7.app/label"
		}, "heavyCloneLabel")
		// Raw Pgen — resolved BY REF from args (gen-prob's Pgen column, which the
		// model matched by name + this dataset's clonotype axis). The ref's
		// presence in args is what makes convergence DEPEND on gen-prob, so its
		// Pgen export is in THIS workflow's context pool. An anchored query can't
		// reach it: gen-prob is a sibling under MiXCR, not an upstream, so it's
		// absent from the workflow pool and the query would silently find nothing
		// (→ full-STAR degrades to 0 hits). By-ref resolution lands the data.
		if !is_undefined(args.pgenRefHeavy) {
			bb.addSingle(args.pgenRefHeavy, "heavyPgen")
		}
	}

	if !is_undefined(args.chainL) {
		// In SC mode chainL === chainH (same anchor); re-binding under a
		// distinct alias is a no-op for the underlying ref but lets us
		// label-tag the heavy / light siblings separately.
		bb.addAnchor("light", args.chainL)
		bb.addSingle({
			axes: [{ anchor: "light", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: cdr3DomainFor("aminoacid", args.chainLScLetter)
		}, "lightAaCDR3")
		bb.addSingle({
			axes: [{ anchor: "light", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: cdr3DomainFor("nucleotide", args.chainLScLetter)
		}, "lightNtCDR3")
		bb.addMulti({
			axes: [{ anchor: "light", idx: 0 }],
			name: "pl7.app/label"
		}, "lightSampleLabel")
		bb.addMulti({
			axes: [{ anchor: "light", idx: 1 }],
			name: "pl7.app/label"
		}, "lightCloneLabel")
		if !is_undefined(args.pgenRefLight) {
			bb.addSingle(args.pgenRefLight, "lightPgen")
		}
	}

	// Optional sample metadata for the clonotype-only aggregation (A-0011),
	// dataset-level and sampleId-keyed: the expected-sample eligibility filter
	// and the independence grouping. Resolved BY REF — the model carries these
	// PlRefs in args to establish the dependency on the samples block, exactly
	// like the Pgen ref. Absent → the aggregation runs its default (every
	// sample an independent, eligible unit).
	if !is_undefined(args.expectedFilterRef) {
		bb.addSingle(args.expectedFilterRef, "expectedFilter")
	}
	if !is_undefined(args.groupingRef) {
		bb.addSingle(args.groupingRef, "grouping")
	}

	return { columns: bb.build() }
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()
	columns := args.columns

	// Friendly chain qualifier appended to user-facing column labels
	// ONLY in dual-chain mode (SC paired — both chainH and chainL set).
	// Single-chain runs (bulk heavy, bulk light, SC heavy-only) skip
	// the suffix because there's no peer to disambiguate against.
	friendlyChain := func(chainName) {
		if chainName == "IGHeavy" { return "Heavy" }
		if chainName == "IGLight" { return "Light" }
		if chainName == "IGKappa" { return "Light (κ)" }
		if chainName == "IGLambda" { return "Light (λ)" }
		return chainName
	}
	dualChain := !is_undefined(args.chainH) && !is_undefined(args.chainL)

	// full-STAR FDR target. Defaulted here so the workflow runs on the STAR
	// default even before the model projects `alpha` into args.
	alpha := is_undefined(args.alpha) ? 0.005 : args.alpha

	// runChainPipeline — closure for one chain. Packs the chain's aa+nt CDR3
	// (and, when a Pgen sibling resolved, the per-clonotype Pgen) into a single
	// String column per (sampleId, clonotypeKey), then fans out per sample via
	// processColumn: Stage 1 (neighbours) → Stage 2 (full-STAR when Pgen is
	// present, else fast-STAR fallback) → optional Stage 3 (cluster filter)
	// inside each per-sample body. Reassembles the per-sample outputs into a
	// pframe of convergence PColumns chain-tagged with `chainName` and
	// method-tagged. Returns the pframe.
	runChainPipeline := func(anchorRef, aaKey, ntKey, labelKey, cloneLabelKey, pgenKey, hasPgen, chainName, threshold, scLetter) {
		// withChain appends the chain qualifier as " / Heavy" /
		// " / Light" in dual-chain mode; returns the base label
		// untouched in single-chain mode. Uniform shape across all
		// columns regardless of whether the base label has parens.
		chainLabel := friendlyChain(chainName)
		withChain := func(base) {
			if !dualChain { return base }
			return base + " / " + chainLabel
		}
		anchorSpec := columns.getSpec(anchorRef)
		labelCols := columns.getColumns(labelKey)

		// full-STAR vs fast-STAR is decided by the dataset-facts snapshot
		// (hasPgen, threaded from args via the caller), not by live pool state —
		// so UI, args, and workflow agree on the method (A-0009/A-0010).
		method := hasPgen ? "full-STAR" : "fast-STAR"

		// ---- Per-sample dedup ----
		// Pack the CDR3 sequences into ONE String value per (sampleId,
		// clonotypeKey), partition by sampleId, then processColumn collapses the
		// clonotype axis so each group = one sample. The runner does NOT pass the
		// group key (sampleId) into the body render (passKey is off) — so the
		// per-sample body node's cache id depends only on its sample's clonotype
		// data, independent of the project-local sampleId. The join uses the
		// abundance column as the sampleId carrier, and the per-sample output
		// comes back keyed by the sampleId. A subset project recovers each
		// shared sample from cache; a sample reassigned a different sampleId in
		// another project still recovers (its body input is sampleId-free).
		//
		// The whole-dataset join+pack+import runs in the :pack-input template so
		// its output can be PINNED (output TTL below). Without pinning, these
		// intermediates are GC'd once processColumn consumes them, forcing a
		// second block / project copy to rebuild the whole preamble before it can
		// recover the (pinned) per-sample results. `packedData` is the pinned
		// packed-column data; its spec is reconstructed here (static) because
		// processColumn needs the spec as a concrete value at graph-build time.
		packInputs := {
			aaData: columns.getColumn(aaKey).data,
			aaSpec: columns.getColumn(aaKey).spec,
			ntData: columns.getColumn(ntKey).data,
			ntSpec: columns.getColumn(ntKey).spec,
			abundanceData: columns.getColumn(anchorRef).data,
			abundanceSpec: columns.getColumn(anchorRef).spec,
			sampleAxisSpec: anchorSpec.axesSpec[0],
			clonoAxisSpec: anchorSpec.axesSpec[1],
			// Explicit flag drives the packed FORMAT (2- vs 3-field) in
			// :pack-input, and the SAME flag drives the unpack pattern in the
			// per-sample body (via processColumn extra) — so pack and unpack can
			// never disagree on field count.
			hasPgen: hasPgen
		}
		// full-STAR: pack the per-clonotype Pgen alongside the CDR3s so it rides
		// the per-sample slice (it's clonotype-only, broadcasts onto sampleId).
		if hasPgen {
			pgenCol := columns.getColumn(pgenKey)
			packInputs.pgenData = pgenCol.data
			packInputs.pgenSpec = pgenCol.spec
		}
		packRender := render.create(packInputTpl, packInputs)
		packedData := packRender.output("packed", 24 * times.hour)
		packedColumn := {
			spec: {
				kind: "PColumn",
				name: "pl7.app/vdj/convergence/perSampleInput",
				valueType: "String",
				axesSpec: [anchorSpec.axesSpec[0], anchorSpec.axesSpec[1]],
				annotations: { "pl7.app/label": "Per-sample convergence input (packed)" }
			},
			data: packedData
		}

		// Convergence output column specs (A-0012). One stable name across
		// methods; full-STAR vs fast-STAR distinguished by the `method` domain
		// (like heavy/light via `chain`). starScore's value semantics + non-
		// identity annotations differ by method: full-STAR = -log10(p) (no fixed
		// threshold); fast-STAR = nbFreq frequency (keeps .3~% + threshold line).
		// Stage-3 cluster columns only when the filter is enabled — must match
		// exactly what the body's TSV carries (xsv.importFile errors on
		// declared-but-missing).
		// Chain identity on the convergence columns MUST follow the dataset's
		// convention so downstream enrichment matches by the same axes+domain the
		// clonotype-key columns use. Bulk: chain lives on the clonotype-key axis
		// domain, and blocks additionally stamp pl7.app/vdj/chain on the value
		// column. SC: heavy and light hang off the SAME scClonotypeKey axis and are
		// distinguished by the column-domain pl7.app/vdj/scClonotypeChain letter
		// ("A"/"B") — NOT pl7.app/vdj/chain (a bulk-style domain with no meaning on
		// an SC column that would break enrichment against SC siblings such as
		// gen-prob's Pgen). scLetter is defined <=> SC mode (from the model).
		isSC := !is_undefined(scLetter)
		convDomain := {
			"pl7.app/block": blockId,
			"pl7.app/vdj/convergence/method": method
		}
		if isSC {
			convDomain["pl7.app/vdj/scClonotypeChain"] = scLetter
		} else {
			convDomain["pl7.app/vdj/chain"] = chainName
		}
		starScoreAnn := {
			"pl7.app/label": withChain("Convergence score"),
			"pl7.app/table/visibility": "default",
			"pl7.app/isScore": "true",
			"pl7.app/score/rankingOrder": "decreasing"
		}
		if hasPgen {
			starScoreAnn["pl7.app/description"] = "full-STAR convergence score: -log10 of the Benjamini-Hochberg-tested Poisson-tail p-value against the clone's generation-probability null. Higher = more convergent (less probable under recombination alone). Per sample."
		} else {
			starScoreAnn["pl7.app/description"] = "fast-STAR convergence score: convergent neighbour frequency (same-length aa CDR3s differing by one aa, over unique nucleotide CDR3s). Higher = denser one-mutation neighbourhood. Per sample; the fast-STAR threshold is applied to this value."
			starScoreAnn["pl7.app/format"] = ".3~%"
			starScoreAnn["pl7.app/graph/thresholds"] = string(json.encode([{ value: threshold, label: "Threshold" }]))
		}
		columnSpecs := [
			{ column: "neighbours", spec: {
				name: "pl7.app/vdj/convergence/neighbours",
				valueType: "Int",
				domain: convDomain,
				annotations: {
					"pl7.app/label": withChain("Convergent neighbours"),
					"pl7.app/table/visibility": "default",
					"pl7.app/description": "Raw count of same-length amino-acid CDR3 neighbours for this clone in the sample (multiplicity-weighted)."
				}
			}},
			{ column: "starHit", spec: {
				name: "pl7.app/vdj/convergence/starHit",
				valueType: "String",
				domain: convDomain,
				annotations: {
					"pl7.app/label": withChain("Convergent hit"),
					"pl7.app/description": "Whether this clone is called convergent. full-STAR: an FDR-controlled Poisson test of the neighbour count against the generation-probability null (Benjamini-Hochberg at the FDR target alpha). fast-STAR (fallback): convergent neighbour frequency above the configured threshold. Per sample.",
					"pl7.app/table/visibility": "default",
					"pl7.app/isDiscreteFilter": "true",
					"pl7.app/discreteValues": string(json.encode(["Hit", "Not hit"])),
					"pl7.app/isScore": "true",
					"pl7.app/score/defaultCutoff": string(json.encode(["Hit"]))
				}
			}},
			{ column: "starScore", spec: {
				name: "pl7.app/vdj/convergence/starScore",
				valueType: "Double",
				domain: convDomain,
				annotations: starScoreAnn
			}}
		]
		if args.applyClusterFilter {
			columnSpecs = append(columnSpecs,
				{ column: "starHitClusterFiltered", spec: {
					name: "pl7.app/vdj/convergence/starHitClusterFiltered",
					valueType: "String",
					domain: convDomain,
					annotations: {
						"pl7.app/label": withChain("Convergent hit (cluster-filtered)"),
						"pl7.app/description": "Stricter binder signal: a convergent hit whose CDR3 also belongs to a cluster of similar CDR3s (one-edit distance) of at least the configured minimum size. Suppresses noise; a strict subset of Convergent hit. Per sample.",
						"pl7.app/table/visibility": "default",
						"pl7.app/isDiscreteFilter": "true",
						"pl7.app/discreteValues": string(json.encode(["Hit", "Not hit"]))
					}
				}},
				{ column: "clusterSize", spec: {
					name: "pl7.app/vdj/convergence/clusterSize",
					valueType: "Int",
					domain: convDomain,
					annotations: {
						"pl7.app/label": withChain("Convergent cluster size"),
						"pl7.app/description": "Size of the CDR3 cluster (one-edit distance) this clone belongs to. Per sample.",
						"pl7.app/table/visibility": "default"
					}
				}}
			)
		}

		perSampleResult := pframes.processColumn(
			packedColumn,
			perSampleNeighboursTpl,
			[{
				type: "Xsv",
				xsvType: "tsv",
				name: "neighbours",
				path: ["outputTsv"],
				settings: {
					axes: [{ column: "clonotypeKey", spec: anchorSpec.axesSpec[1] }],
					columns: columnSpecs,
					storageFormat: "Parquet",
					partitionKeyLength: 0
				}
			}, {
				// Per-sample compute-neighbours stdout, captured as String content
				// and collected into a Resource keyed by the group axis (sampleId).
				// The sampleId axis is added automatically; spec.axesSpec stays empty.
				type: "Resource",
				name: "log",
				path: ["log"],
				spec: {
					kind: "PColumn",
					name: "pl7.app/log",
					valueType: "String",
					domain: { "pl7.app/block": blockId, "pl7.app/vdj/chain": chainName }
				}
			}, {
				// Per-sample { nUniqueNt, nMin } JSON, keyed by sampleId. Exists
				// even for skipped samples (empty TSV), so the model can build the
				// skipped-samples warning from it.
				type: "Resource",
				name: "status",
				path: ["status"],
				spec: {
					kind: "PColumn",
					name: "pl7.app/vdj/convergence/perSampleStatus",
					valueType: "Json",
					domain: { "pl7.app/block": blockId, "pl7.app/vdj/chain": chainName }
				}
			}],
			{
				aggregate: [{ name: anchorSpec.axesSpec[1].name }],
				cpu: 2,
				mem: "4GiB",
				// Pin each per-sample iteration so its result survives
				// reference-counting GC between renders; without this the
				// per-sample nodes are dropped and re-executed every run,
				// defeating cross-run / cross-project recovery (matches the
				// cacheHours(24) the whole-dataset compute-neighbours uses).
				stepCache: 24 * times.hour,
				extra: {
					clonoAxisSpec: anchorSpec.axesSpec[1],
					nMin: args.nMin,
					threshold: threshold,
					alpha: alpha,
					hasPgen: hasPgen,
					applyClusterFilter: args.applyClusterFilter,
					clusterMin: args.clusterMin,
					chain: chainName
				}
			}
		)
		// ---- end per-sample fan-out setup; pf is built from perSampleResult below ----

		// Combined per-sample convergence TSV (keyed by the sampleId),
		// reused for the hit-count badge.
		//
		// xsv.exportFrame writes each column's pl7.app/label as the TSV header, so
		// build a header-stable pframe (field-name labels on the value columns and
		// "sampleId"/"clonotypeKey" on the axes) — otherwise the rich table labels
		// would become the headers and the stats pt couldn't find
		// "starHit" / "sampleId".
		exportSrcBuilder := pframes.pFrameBuilder()
		for columnName in perSampleResult.listXsvColumns("neighbours") {
			origSpec := perSampleResult.outputSpec("neighbours", columnName)
			exportSrcBuilder.add(columnName, {
				kind: "PColumn",
				name: origSpec.name,
				valueType: origSpec.valueType,
				domain: origSpec.domain,
				annotations: { "pl7.app/label": columnName },
				axesSpec: [
					{ name: anchorSpec.axesSpec[0].name, type: anchorSpec.axesSpec[0].type, domain: anchorSpec.axesSpec[0].domain, annotations: { "pl7.app/label": "sampleId" } },
					{ name: anchorSpec.axesSpec[1].name, type: anchorSpec.axesSpec[1].type, domain: anchorSpec.axesSpec[1].domain, annotations: { "pl7.app/label": "clonotypeKey" } }
				]
			}, perSampleResult.outputData("neighbours", columnName))
		}
		perSampleTsv := xsv.exportFrame(exportSrcBuilder.build(), "tsv", {})

		// Trace label carries the distinguishing settings (threshold(s),
		// nMin, cluster filter) so downstream deriveDistinctLabels can tell
		// apart columns from multiple convergence blocks reading the same
		// dataset. customBlockLabel (user override) wins; else the
		// parameter-encoding defaultBlockLabel; static name as last resort.
		traceLabel := args.customBlockLabel || args.defaultBlockLabel || ("Clonotype convergence (" + method + ")")
		trace := pSpec.makeTrace(anchorSpec, {
			type: "milaboratories.clonotype-convergence",
			id: blockId,
			importance: 50,
			label: traceLabel
		})

		// Build the block's multi-sample pframe from the per-sample fan-out
		// result. processColumn reassembles per-sample outputs keyed by
		// (sampleId, clonotypeKey); inject the block trace into each column.
		pfBuilder := pframes.pFrameBuilder()
		for columnName in perSampleResult.listXsvColumns("neighbours") {
			pfBuilder.add(
				columnName,
				trace.inject(perSampleResult.outputSpec("neighbours", columnName)),
				perSampleResult.outputData("neighbours", columnName)
			)
		}
		// Bundle the upstream label columns into the pframe so the
		// histogram's "Show for" picker and tooltips render sample
		// names + Clone IDs without the model needing to do anchored
		// discovery at render time. No trace.inject — we're re-emitting
		// upstream-owned labels, not claiming ownership.
		for i, c in columns.getColumns(labelKey) {
			pfBuilder.add("sampleLabel_" + string(i), c.spec, c.data)
		}
		for i, c in columns.getColumns(cloneLabelKey) {
			pfBuilder.add("cloneLabel_" + string(i), c.spec, c.data)
		}

		// ---- Stage 4: aggregate to the clonotype-only axis (A-0011) ----
		// Collapse the per-sample signal to one value per clonotype so the
		// downstream in-vivo score / lead selection can consume it (A-0006). Only
		// starScore + starHit are exported (+ a support count); neighbours stays a
		// per-sample inner/QC value (A-0012 follow-up). The aggregation RULES (max,
		// two-level grouping, k-replicability, eligibility filter, alpha-trim) live
		// in the `aggregate` software — parameterised so they can change (Q-0009)
		// without touching the workflow. Input is the reassembled per-sample TSV.
		// k is not user-exposed (A-0011/A-0015): the model sets it to 2 when an
		// independence grouping is present, else 1. `w` is the strength↔
		// reproducibility weight for the starScore blend (Advanced, default 0.5).
		aggReplicabilityK := is_undefined(args.replicabilityK) ? 1 : args.replicabilityK
		scoreWeight := is_undefined(args.scoreWeight) ? 0.5 : args.scoreWeight
		aggCmd := exec.builder().
			software(aggregateSw).
			cpu(1).
			mem("4GiB").
			arg("--input").arg("per_sample.tsv").
			arg("--output").arg("aggregated.tsv").
			arg("--chain").arg(chainName).
			arg("--method").arg(method).
			arg("--alpha").arg(string(alpha)).
			arg("--k").arg(string(aggReplicabilityK)).
			arg("--weight").arg(string(scoreWeight)).
			addFile("per_sample.tsv", perSampleTsv).
			saveFile("aggregated.tsv")
		// fast-STAR fallback aggregates against the same nbFreq threshold.
		if !hasPgen {
			aggCmd = aggCmd.arg("--threshold").arg(string(threshold))
		}
		// Sample-metadata TSV (sampleId + optional expected / unit), from the
		// by-ref-resolved metadata columns; aggregate.py joins it on sampleId.
		if !is_undefined(args.expectedFilterRef) || !is_undefined(args.groupingRef) {
			metaBuilder := pframes.tsvFileBuilder()
			metaBuilder.setAxisHeader(anchorSpec.axesSpec[0].name, "sampleId")
			if !is_undefined(args.expectedFilterRef) {
				ef := columns.getColumn("expectedFilter")
				metaBuilder.add({ spec: ef.spec, data: ef.data }, { header: "expected" })
			}
			if !is_undefined(args.groupingRef) {
				gr := columns.getColumn("grouping")
				metaBuilder.add({ spec: gr.spec, data: gr.data }, { header: "unit" })
			}
			aggCmd = aggCmd.arg("--metadata").arg("meta.tsv").addFile("meta.tsv", metaBuilder.build())
			if !is_undefined(args.expectedFilterRef) && !is_undefined(args.expectedValues) {
				// json.encode returns bytes; exec.arg needs a string.
				aggCmd = aggCmd.arg("--expected-values").arg(string(json.encode(args.expectedValues)))
			}
		}
		aggregatedTsv := aggCmd.run().getFile("aggregated.tsv")

		// Hit-count stats badge: {above, total}, counted over the AGGREGATED,
		// clonotype-only export (A-0011) — one row per clonotype. `above` = clones
		// called convergent across the repertoire (starHit == "Hit"); `total` =
		// clonotypes. This is the exported signal's own summary; the old per-sample
		// sum (a clonotype counted once per sample it appeared in) is not meaningful
		// for the aggregated result the block now surfaces.
		statsWf := pt.workflow().mem("2GiB").cpu(1)
		statsDf := statsWf.frame(aggregatedTsv, { xsvType: "tsv", inferSchema: false })
		statsDf.select(
			pt.col("starHit").count().alias("total"),
			pt.when(pt.col("starHit").eq(pt.lit("Hit"))).then(pt.lit(1)).otherwise(pt.lit(0)).sum().alias("above")
		).saveContent("stats.ndjson")
		finalStatsJson := statsWf.run().getFileContent("stats.ndjson")

		// The exported starScore is the AGGREGATED reproducibility blend (A-0011):
		// a percentile in [0,1], method-agnostic (NOT the per-sample -log10 p /
		// nbFreq), so it carries none of the per-sample format / threshold-line
		// annotations. Higher = more convergent and/or more reproducible.
		exportStarScoreAnn := {
			"pl7.app/label": withChain("Convergence score"),
			"pl7.app/table/visibility": "default",
			"pl7.app/isScore": "true",
			"pl7.app/score/rankingOrder": "decreasing",
			"pl7.app/description": "Aggregated convergence score on the clonotype axis (A-0011): a weighted blend of the clone's peak per-donor convergence and its cross-donor support, each percentile-ranked across clonotypes (in [0,1]; higher = more convergent and/or more reproducible). The strength-vs-reproducibility weight is a block setting."
		}

		// Import as clonotype-only PColumns (no sampleId axis) — the
		// downstream-consumable export family (A-0006): the SAME column identity as
		// the per-sample columns (A-0012), one axis less. Only starScore + starHit
		// are exported; support is internal to the score blend (not a column).
		exportCloneAxis := {
			name: anchorSpec.axesSpec[1].name,
			type: anchorSpec.axesSpec[1].type,
			domain: anchorSpec.axesSpec[1].domain,
			annotations: { "pl7.app/label": "clonotypeKey" }
		}
		aggFrame := xsv.importFile(aggregatedTsv, "tsv", {
			axes: [{ column: "clonotypeKey", spec: exportCloneAxis }],
			columns: [
				{ column: "starScore", spec: {
					name: "pl7.app/vdj/convergence/starScore",
					valueType: "Double",
					domain: convDomain,
					annotations: exportStarScoreAnn
				}},
				{ column: "starHit", spec: {
					name: "pl7.app/vdj/convergence/starHit",
					valueType: "String",
					domain: convDomain,
					annotations: {
						"pl7.app/label": withChain("Convergent hit"),
						"pl7.app/description": "Whether this clone is called convergent across the repertoire (aggregated to the clonotype axis). full-STAR: Benjamini-Hochberg across clonotypes of the per-clonotype combined p-value at the FDR target alpha (>= k units when replicability is on); fast-STAR: aggregated neighbour frequency above the threshold.",
						"pl7.app/isDiscreteFilter": "true",
						"pl7.app/discreteValues": string(json.encode(["Hit", "Not hit"])),
						"pl7.app/isScore": "true",
						"pl7.app/score/defaultCutoff": string(json.encode(["Hit"]))
					}
				}}
			],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}, { splitDataAndSpec: true, mem: "2GiB", cpu: 1 })

		// Clonotype-only export pframe, block trace injected (owned output). This
		// is the block's OWN model-facing aggregated family (starScore + starHit),
		// kept one-row-per-clonotype so the aggregated table + score histogram stay
		// clonotype-only.
		exportPfBuilder := pframes.pFrameBuilder()
		exportPfBuilder.add("starScore", trace.inject(aggFrame["starScore"].spec), aggFrame["starScore"].data)
		exportPfBuilder.add("starHit", trace.inject(aggFrame["starHit"].spec), aggFrame["starHit"].data)

		// Pool export family (A-0006): the aggregated starScore + starHit PLUS the
		// full per-sample Convergent-neighbours column (both sampleId and
		// clonotypeKey axes). Downstream (lead selection) consumes the raw
		// per-sample neighbour count alongside the aggregated signal, so the pool
		// export carries it in full; the block's own model family (exportPf) stays
		// clonotype-only so its table doesn't fan back out over samples.
		neighboursSpec := perSampleResult.outputSpec("neighbours", "neighbours")
		neighboursData := perSampleResult.outputData("neighbours", "neighbours")
		poolExportPfBuilder := pframes.pFrameBuilder()
		poolExportPfBuilder.add("starScore", trace.inject(aggFrame["starScore"].spec), aggFrame["starScore"].data)
		poolExportPfBuilder.add("starHit", trace.inject(aggFrame["starHit"].spec), aggFrame["starHit"].data)
		poolExportPfBuilder.add("neighbours", trace.inject(neighboursSpec), neighboursData)

		return {
			pf: pfBuilder.build(),
			// Clonotype-only aggregated family — the block's own model-facing table.
			exportPf: exportPfBuilder.build(),
			// Downstream-consumable pool export (aggregated + per-sample neighbours).
			poolExportPf: poolExportPfBuilder.build(),
			statsJson: finalStatsJson,
			// Per-sample fan-out sidecars, keyed by the sampleId. The model
			// attaches sample labels (logs) and builds the skipped-samples
			// warning (status).
			perSampleLogs: perSampleResult.outputData("log"),
			perSampleStatus: perSampleResult.outputData("status")
		}
	}

	outputs := {}
	exports := {}

	// Heavy pipeline — runs when chainH is populated.
	if !is_undefined(args.chainH) {
		heavy := runChainPipeline(
			args.chainH,
			"heavyAaCDR3",
			"heavyNtCDR3",
			"heavySampleLabel",
			"heavyCloneLabel",
			"heavyPgen",
			args.hasPgenHeavy == true,
			args.chainHName,
			args.thresholdH,
			args.chainHScLetter
		)
		// Multi-sample family stays INTERNAL: it drives this block's own
		// table + histograms only. It is not pooled downstream — consumers
		// enrich by clonotype key, never by sampleId axis.
		outputs.convergencePf = pframes.exportFrame(heavy.pf)
		outputs.heavyHitStats = heavy.statsJson
		outputs.heavyPerSampleLogs = heavy.perSampleLogs
		outputs.heavyPerSampleStatus = heavy.perSampleStatus
		// Clonotype-only aggregated family → the result pool (A-0006/A-0011):
		// the downstream-consumable convergence signal. exports take the raw
		// built pframe (not exportFrame — that's for model-facing outputs).
		exports.heavyConvergence = heavy.poolExportPf
		// Clonotype-only family as a model-facing output so the block shows the
		// aggregated data in its own Main table + score histogram.
		outputs.heavyAggregatedPf = pframes.exportFrame(heavy.exportPf)
	}

	// Light pipeline — runs when chainL is populated.
	if !is_undefined(args.chainL) {
		light := runChainPipeline(
			args.chainL,
			"lightAaCDR3",
			"lightNtCDR3",
			"lightSampleLabel",
			"lightCloneLabel",
			"lightPgen",
			args.hasPgenLight == true,
			args.chainLName,
			args.thresholdL,
			args.chainLScLetter
		)
		// Light multi-sample family also internal-only — see heavy above.
		outputs.lightConvergencePf = pframes.exportFrame(light.pf)
		outputs.lightHitStats = light.statsJson
		outputs.lightPerSampleLogs = light.perSampleLogs
		outputs.lightPerSampleStatus = light.perSampleStatus
		exports.lightConvergence = light.poolExportPf
		outputs.lightAggregatedPf = pframes.exportFrame(light.exportPf)
	}

	return {
		outputs: outputs,
		exports: exports
	}
})
